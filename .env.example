# Application
APP_NAME=Automated Data Cleaning & Quality Management System
APP_ENV=development

# Database (PostgreSQL) — replace with your own local values in .env
DATABASE_URL=postgresql+psycopg://datacleaner:change_me@localhost:5432/data_cleaning_db

# Frontend → Backend
API_BASE_URL=http://localhost:8000

# Upload limits
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs